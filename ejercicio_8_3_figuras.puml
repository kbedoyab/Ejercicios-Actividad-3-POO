@startuml

abstract class FiguraGeometrica {
    - volumen : float
    - superficie : float
    + __init__()
    + get_volumen() : float
    + set_volumen(volumen)
    + get_superficie() : float
    + set_superficie(superficie)
    + calcular_volumen() : float
    + calcular_superficie() : float
}

class Cilindro {
    - radio : float
    - altura : float
    + __init__(radio, altura)
    + calcular_volumen() : float
    + calcular_superficie() : float
}

class Esfera {
    - radio : float
    + __init__(radio)
    + calcular_volumen() : float
    + calcular_superficie() : float
}

class Piramide {
    - base : float
    - altura : float
    - apotema : float
    + __init__(base, altura, apotema)
    + calcular_volumen() : float
    + calcular_superficie() : float
}

class VentanaPrincipal {
    - root : Tk
    - resultado : Label
    + __init__(root)
    + mostrar_resultado(figura)
    + crear_ventana(titulo, campos, funcion)
    + ventana_cilindro()
    + ventana_esfera()
    + ventana_piramide()
}

FiguraGeometrica <|-- Cilindro
FiguraGeometrica <|-- Esfera
FiguraGeometrica <|-- Piramide
VentanaPrincipal --> FiguraGeometrica : crea/usa

@enduml
